# MoCapWeb — regras da pasta raiz do sistema
# 1) Páginas HTML e PHP nunca ficam presas no cache do navegador:
#    toda atualização do sistema aparece na hora (sem Ctrl+F5).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
# 2) Arquivos sensíveis não são servidos
<FilesMatch "\.(env|sql|log|md|example\.php)$">
  Require all denied
</FilesMatch>
