# .htaccess da pasta mocapweb/
# A entrada do sistema é o index.php, que exige login no servidor antes de
# entregar o MocapWeb. O index.html é só um redirecionamento para o index.php.

Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Quem pedir index.html diretamente é atendido pelo index.php.
  RewriteRule ^index\.html$ index.php [L]
</IfModule>

# Arquivos internos (só são lidos por "require" no PHP; nunca pelo navegador).
<FilesMatch "^(config\.php|config\.example\.php|db\.php|dominio\.php|guarda\.php)$">
  Require all denied
</FilesMatch>

# Documentação e dados do repositório não são servidos.
<FilesMatch "\.(md|csv|json|sql)$">
  Require all denied
</FilesMatch>
